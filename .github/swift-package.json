{
  "compilers": [
    {
      "name": "macos-26-xcode-26.6",
      "runner": "macos-26",
      "xcode": "26.6"
    }
  ],
  "format": {
    "paths": [
      "Package.swift",
      "Sources",
      "Tests"
    ]
  },
  "docs": {
    "targets": [
      "SwiftDataWritable"
    ]
  },
  "platforms": {
    "apple": [
      {
        "name": "ios",
        "platform": "iOS",
        "scheme": "swift-data-writable"
      },
      {
        "name": "tvos",
        "platform": "tvOS",
        "scheme": "swift-data-writable"
      },
      {
        "name": "watchos",
        "platform": "watchOS",
        "scheme": "swift-data-writable"
      }
    ]
  }
}

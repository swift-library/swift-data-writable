"""Install simulator components matching the selected Xcode's platform SDKs."""

import argparse
import json
from pathlib import Path
import platform
import subprocess


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    platforms = {"iOS": "iphonesimulator", "tvOS": "appletvsimulator", "watchOS": "watchsimulator"}
    evidence = []
    for name, sdk in platforms.items():
        version = subprocess.check_output(["xcrun", "--sdk", sdk, "--show-sdk-version"], text=True).strip()
        runtimes = json.loads(subprocess.check_output(["xcrun", "simctl", "list", "runtimes", "--json"]))["runtimes"]
        matches = [runtime for runtime in runtimes if runtime.get("isAvailable")
                   and runtime["identifier"].startswith("com.apple.CoreSimulator.SimRuntime." + name + "-")
                   and runtime["version"] == version]
        if not matches:
            subprocess.run([
                "xcodebuild", "-downloadPlatform", name, "-buildVersion", version,
                "-architectureVariant", "arm64" if platform.machine() == "arm64" else "universal",
            ], check=True)
            runtimes = json.loads(subprocess.check_output(["xcrun", "simctl", "list", "runtimes", "--json"]))["runtimes"]
            matches = [runtime for runtime in runtimes if runtime.get("isAvailable")
                       and runtime["identifier"].startswith("com.apple.CoreSimulator.SimRuntime." + name + "-")
                       and runtime["version"] == version]
        if not matches:
            raise RuntimeError("No installed " + name + " simulator component matching SDK " + version)
        evidence.append({"platform": name, "sdk_version": version,
                         "runtimes": [{key: runtime[key] for key in ("identifier", "version", "buildversion")}
                                      for runtime in matches]})
    root = Path(__file__).resolve().parent.parent
    output = root / ".build/release-validation/platform-components.json"
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps({"platforms": evidence}, indent=2) + "\n")


if __name__ == "__main__":
    main()

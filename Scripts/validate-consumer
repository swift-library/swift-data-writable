"""Validate independent library consumption and preserve platform evidence."""

import argparse
import hashlib
import json
from pathlib import Path
import platform
import re
import shutil
import subprocess
import sys
import uuid


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    reference = parser.add_mutually_exclusive_group(required=True)
    reference.add_argument("--local", action="store_true")
    reference.add_argument("--revision")
    reference.add_argument("--version")
    parser.add_argument("--ios", action="store_true")
    parser.add_argument("--build-platforms", action="store_true")
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()
    checker_digest = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    root = Path(__file__).resolve().parent.parent
    config = json.loads((root / ".github/release.json").read_text())
    if args.revision and not re.fullmatch(r"[0-9a-f]{40}", args.revision):
        parser.error("Use the complete candidate commit SHA")
    version_command = [str(root / "Scripts/validate-version"), "--json"]
    if not args.local:
        version_command += ["--require-clean"]
    version_info = json.loads(subprocess.check_output(version_command, text=True))
    if args.version and args.version != version_info["version"]:
        parser.error("Version acceptance must use the declared package version")
    if args.revision and args.revision != version_info["commit"]:
        parser.error("Revision acceptance must use the checked-out candidate")
    output = args.output.resolve()
    if output.exists():
        parser.error("Use a new output directory for each acceptance run")
    output.mkdir(parents=True)
    package = output / "package"
    shutil.copytree(root / "Tests/Fixtures/ReleaseConsumer", package)
    identity = config["repository"].split("/")[-1]
    url = "https://github.com/" + config["repository"] + ".git"
    if args.local:
        declaration = ".package(name: " + json.dumps(identity) + ", path: " + json.dumps(str(root)) + ")"
    else:
        requirement = "revision: " + json.dumps(args.revision) if args.revision else ".exact(" + json.dumps(args.version) + ")"
        declaration = ".package(url: " + json.dumps(url) + ", " + requirement + ")"
    manifest = package / "Package.swift"
    text, count = re.subn(
        r'\.package\(\s*url:\s*"' + re.escape(url)
        + r'",\s*revision:\s*"release-candidate"\s*\)',
        lambda _: declaration, manifest.read_text(),
    )
    if count != 1:
        raise ValueError("Expected one consumer dependency declaration")
    manifest.write_text(text)
    checks = []

    def run(name, command):
        print(name, flush=True)
        log_path = output / (name + ".log")
        with log_path.open("w") as log:
            result = subprocess.run(command, cwd=package, stdout=log, stderr=subprocess.STDOUT, timeout=1800)
        checks.append({"name": name, "exit_status": result.returncode})
        if result.returncode:
            print("\n".join(log_path.read_text(errors="replace").splitlines()[-80:]), file=sys.stderr)
            raise RuntimeError(name + " failed; inspect " + str(log_path))

    run("resolve", ["swift", "package", "resolve"])
    lock_path = package / "Package.resolved"
    lock = json.loads(lock_path.read_text())
    dependency = {"commit": version_info["commit"], "dirty": version_info["dirty"], "kind": "local"}
    if not args.local:
        selected = next(pin for pin in lock["pins"] if pin["identity"] == identity)
        dependency = selected["state"]
        if dependency["revision"] != version_info["commit"]:
            raise RuntimeError("Resolved source differs from the candidate")
        if args.version and dependency.get("version") != args.version:
            raise RuntimeError("Resolved version differs from the accepted tag")
    run("native-tests", ["swift", "test", "--force-resolved-versions"])
    run("release-build", ["swift", "build", "-c", "release", "--force-resolved-versions"])
    derived = output / "DerivedData"
    build_checks = []
    if args.build_platforms:
        destinations = {"iOS": "iOS Simulator", "tvOS": "tvOS Simulator", "watchOS": "watchOS Simulator"}
        for name, destination in destinations.items():
            run(name.lower() + "-minimum-build", [
                "xcodebuild", "build", "-scheme", "ReleaseConsumer",
                "-destination", "generic/platform=" + destination,
                "-derivedDataPath", str(derived), "-disableAutomaticPackageResolution",
                "-skipMacroValidation", "CODE_SIGNING_ALLOWED=NO",
            ])
            build_checks.append({"platform": name, "minimum": min(config["platforms"][name])})
    simulators = []
    if args.ios:
        runtimes = json.loads(subprocess.check_output(["xcrun", "simctl", "list", "runtimes", "--json"]))["runtimes"]
        for generation in config["platforms"]["iOS"]:
            available = [r for r in runtimes if r.get("platform") == "iOS" and r.get("isAvailable")
                         and int(r["version"].split(".")[0]) == generation]
            if not available:
                raise RuntimeError("No installed iOS runtime for generation " + str(generation))
            runtime = max(available, key=lambda r: tuple(map(int, r["version"].split("."))))
            device_type = next(d["identifier"] for d in runtime["supportedDeviceTypes"] if d["productFamily"] == "iPhone")
            device = subprocess.check_output([
                "xcrun", "simctl", "create", "SwiftDataWritableAcceptance-" + uuid.uuid4().hex[:8],
                device_type, runtime["identifier"],
            ], text=True).strip()
            try:
                name = "ios-" + runtime["version"]
                run(name, ["xcodebuild", "test", "-scheme", "ReleaseConsumer",
                           "-destination", "platform=iOS Simulator,id=" + device,
                           "-derivedDataPath", str(derived), "-resultBundlePath", str(output / (name + ".xcresult")),
                           "-disableAutomaticPackageResolution", "-skipMacroValidation", "CODE_SIGNING_ALLOWED=NO"])
                simulators.append({k: runtime[k] for k in ("identifier", "version", "buildversion")})
            finally:
                subprocess.run(["xcrun", "simctl", "shutdown", device], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(["xcrun", "simctl", "delete", device], check=True)
    sdk_versions = {
        sdk: subprocess.check_output(["xcrun", "--sdk", sdk, "--show-sdk-version"], text=True).strip()
        for sdk in ["macosx", "iphonesimulator", "appletvsimulator", "watchsimulator"]
    }
    if (json.loads(subprocess.check_output(version_command, text=True)) != version_info
            or hashlib.sha256(Path(__file__).read_bytes()).hexdigest() != checker_digest):
        raise RuntimeError("Source or checker changed during acceptance; validate a stable candidate")
    evidence = {
        "repository": config["repository"], "source": version_info, "dependency": dependency,
        "dependency_pins": lock["pins"],
        "dependency_lock_sha256": hashlib.sha256(lock_path.read_bytes()).hexdigest(),
        "consumer_manifest_sha256": hashlib.sha256(manifest.read_bytes()).hexdigest(),
        "checker_sha256": checker_digest,
        "os": platform.platform(),
        "swift": subprocess.check_output(["swift", "--version"], text=True).strip(),
        "xcode": subprocess.check_output(["xcodebuild", "-version"], text=True).strip(),
        "sdk_versions": sdk_versions,
        "platform_builds": build_checks, "simulators": simulators, "checks": checks,
    }
    (output / "provenance.json").write_text(json.dumps(evidence, indent=2) + "\n")
    print("Consumer acceptance passed: " + str(output))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, StopIteration, subprocess.SubprocessError) as error:
        print("validate-consumer: " + str(error), file=sys.stderr)
        sys.exit(1)
